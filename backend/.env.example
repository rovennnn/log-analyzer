# Comma-separated list of origins allowed to call the API (CORS).
# Add your deployed frontend's URL in production, e.g.:
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# Optional: override where the SQLite file is written. Defaults to
# backend/log_analyzer.db if unset.
# LOG_ANALYZER_DB_PATH=/data/log_analyzer.db
